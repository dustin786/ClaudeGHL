# Server
PORT=3000
NODE_ENV=development

# API Security — protect /api endpoints
API_KEY=your-secret-api-key-here

# Redis (BullMQ job queues)
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────
# ANTHROPIC — AI content generation
# ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────────────────────────────
# GoHighLevel — Social Planner + CRM
# Get these from GHL → Settings → Integrations → Private Integration
# ─────────────────────────────────────────────────────────────────────
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_WEBHOOK_SECRET=

# GHL Social Account IDs — get via GET /social-media-posting/{locationId}/oauth/{platform}/accounts
GHL_SOCIAL_ACCOUNT_TIKTOK=
GHL_SOCIAL_ACCOUNT_INSTAGRAM=
GHL_SOCIAL_ACCOUNT_FACEBOOK=
GHL_SOCIAL_ACCOUNT_LINKEDIN=
GHL_SOCIAL_ACCOUNT_YOUTUBE=

# GHL Workflows to trigger on events
GHL_WORKFLOW_ID_VIDEO_PROCESSED=
GHL_WORKFLOW_ID_POSTS_SCHEDULED=

# ─────────────────────────────────────────────────────────────────────
# AWS S3 — processed video hosting (required for GHL to access videos)
# ─────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=dustinai-videos

# ─────────────────────────────────────────────────────────────────────
# Storage — local fallback if S3 not configured
# ─────────────────────────────────────────────────────────────────────
LOCAL_UPLOAD_PATH=/tmp/uploads
LOCAL_PROCESSED_PATH=/tmp/processed

# ─────────────────────────────────────────────────────────────────────
# Brand Assets
# ─────────────────────────────────────────────────────────────────────
SIGNATURE_CLIP_PATH=./assets/signature_ending.mp4
WATERMARK_PATH=./assets/dustinai_logo.png

# ─────────────────────────────────────────────────────────────────────
# Optional: Direct Platform APIs (fallback if GHL Social Planner unavailable)
# ─────────────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
